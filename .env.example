# Links públicos do MVP
NEXT_PUBLIC_AUDIT_FORM_URL=https://tally.so/r/0QRR4A
NEXT_PUBLIC_REPORTS_URL=

# Supabase Auth — valores públicos do projeto
# Prefira a Publishable key nova. NEXT_PUBLIC_SUPABASE_ANON_KEY fica apenas como compatibilidade legada.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Airtable — somente servidor. Nunca exponha o token em NEXT_PUBLIC_*.
AIRTABLE_ACCESS_TOKEN=
AIRTABLE_BASE_ID=
# Safety gate: o preview pode funcionar com as credenciais acima, mas a escrita no Supabase só é liberada com true.
AIRTABLE_IMPORT_ENABLED=false

# Integrações privadas adicionais devem existir somente no servidor/deploy.
GOOGLE_SERVICE_ACCOUNT_JSON=
